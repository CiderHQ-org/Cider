[Desktop Entry]
Type=Application
Name=Roblox Studio (Cider)
Comment=Roblox Studio through Wine
Comment[ru]=Roblox Studio через Wine
Exec=ciderhq --studio %u
Icon=applications-games
Terminal=false
Categories=Development;
