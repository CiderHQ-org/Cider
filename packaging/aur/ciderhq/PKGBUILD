# Maintainer: aubree.wtf <https://aubree.wtf/>
pkgname=ciderhq
# pacman sorts 0.23patch1 before 0.23, but 0.23.patch1 after it.
_tag=0.23patch2
pkgver=0.23.patch2
pkgrel=1
pkgdesc='Run the macOS Roblox client on Linux through Darling'
arch=('x86_64')
url='https://ciderhq.org'
_repo='https://github.com/CiderHQ-org/Cider'
license=('GPL-3.0-only' 'MIT' 'OFL-1.1')
depends=('unzip' 'python' 'python-gobject' 'python-cairo'
         'gtk4>=4.14' 'libadwaita>=1.5' 'webkitgtk-6.0' 'sdl2' 'wayland'
         'libpulse' 'libglvnd' 'libx11' 'libxext' 'libxfixes' 'libxi' 'libxcursor' 'gcc-libs')
depends+=('hicolor-icon-theme' 'shared-mime-info' 'desktop-file-utils')
makedepends=('clang' 'lld' 'pkgconf')
optdepends=('darling: regular Darling runtime'
            'ciderdarling-bin: CiderHQ Darling runtime (also available from the launcher)'
            'mangohud: performance overlay'
            'mesa: Mesa EGL and Zink for the Vulkan renderer'
            'vulkan-icd-loader: Vulkan renderer loader'
            'vulkan-driver: hardware Vulkan driver for the Vulkan renderer'
            'pipewire-audio: native PipeWire audio playback')
provides=('macoblox')
conflicts=('ciderhq-git' 'macoblox' 'macoblox-git')
replaces=('macoblox')
source=("$pkgname-$_tag.tar.gz::$_repo/releases/download/v$_tag/ciderhq-$_tag-source.tar.gz")
sha256sums=('904bf71d497ee5beb151bf146668d3947d2125b85a0dae52b16df58b9f7d48d0')

build() {
  cd "Cider-$_tag"
  MACOBLOX_BUILD_DIR="$srcdir/native-build" ./build_debug_shim.sh
}

package() {
  cd "Cider-$_tag"
  bash packaging/install-payload.sh "$PWD" "$srcdir/native-build" "$pkgdir" /usr/lib
  python -m compileall -q -d /usr/share/ciderhq/launcher "$pkgdir/usr/share/ciderhq/launcher"
}
