pkgbase = ciderhq-git
	pkgdesc = Run the macOS Roblox client on Linux through Darling
	pkgver = 0.22.r0
	pkgrel = 1
	url = https://ciderhq.org
	arch = x86_64
	license = MIT
	license = OFL-1.1
	makedepends = git
	makedepends = clang
	makedepends = lld
	makedepends = pkgconf
	depends = darling
	depends = unzip
	depends = python
	depends = python-gobject
	depends = python-cairo
	depends = gtk4>=4.14
	depends = libadwaita>=1.5
	depends = webkitgtk-6.0
	depends = sdl2
	depends = wayland
	depends = libpulse
	depends = libglvnd
	depends = libx11
	depends = libxext
	depends = libxfixes
	depends = libxi
	depends = libxcursor
	depends = gcc-libs
	depends = hicolor-icon-theme
	depends = shared-mime-info
	depends = desktop-file-utils
	optdepends = mangohud: performance overlay
	optdepends = mesa: Mesa EGL and Zink for the Vulkan renderer
	optdepends = vulkan-icd-loader: Vulkan renderer loader
	optdepends = vulkan-driver: hardware Vulkan driver for the Vulkan renderer
	optdepends = pipewire-audio: native PipeWire audio playback
	provides = ciderhq
	provides = macoblox
	conflicts = ciderhq
	conflicts = macoblox
	conflicts = macoblox-git
	replaces = macoblox-git
	source = MacOBlox::git+https://github.com/aubree-lat/MacOBlox.git
	sha256sums = SKIP

pkgname = ciderhq-git
