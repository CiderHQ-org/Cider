#!/usr/bin/env python3
"""Cider launcher entry point."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

# `ciderhq --studio [link or file]` opens Roblox Studio directly; the system
# calls it for roblox-studio: and roblox-studio-auth: links (sign in).
if sys.argv[1:2] == ["--studio"]:
    from macoblox import studio  # noqa: E402
    if not studio.needs_install():
        studio.launch(sys.argv[2:])
        sys.exit(0)

# Linux has no LaunchServices. Keep the browser's Roblox argument opaque and
# let the normal launcher process consume it once Darling is ready. Writing it
# before starting GTK also covers a second protocol click while the first
# launch is still preparing the prefix. Desktop entries pass the URI directly;
# retain --uri as a compatibility spelling for older local entries.
if len(sys.argv) == 2 and not sys.argv[1].startswith("-"):
    from macoblox import uri  # noqa: E402
    uri.receive(sys.argv[1])

if sys.argv[1:2] == ["--uri"]:
    if len(sys.argv) != 3:
        print("ciderhq --uri requires one URI", file=sys.stderr)
        sys.exit(2)
    from macoblox import uri  # noqa: E402
    uri.receive(sys.argv[2])

# `ciderhq --collect-diagnostics [options]` writes a report archive without
# the interface (see `ciderhq --collect-diagnostics --help`).
if sys.argv[1:2] == ["--collect-diagnostics"]:
    try:
        from macoblox import diagnostics  # noqa: E402
    except ImportError as error:
        print(f"Diagnostics are unavailable in this Cider build: {error}", file=sys.stderr)
        sys.exit(1)
    sys.exit(diagnostics.collect_cli(sys.argv[2:]))

# `ciderhq --ciderdarling-settings` opens Settings -> CiderDarling, also in an
# already running launcher (the CiderDarling Settings menu entry).
page = None
if sys.argv[1:2] == ["--ciderdarling-settings"]:
    page = "ciderdarling"

from macoblox.app import main  # noqa: E402

sys.exit(main(page))
